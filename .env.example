# Copy to .env and fill in. Never commit .env.

PORT=8080
NODE_ENV=development

# Required in production. 32+ random characters.
SESSION_SECRET=

# Staff accounts (bcrypt-equivalent scrypt hashes are created on first boot).
# If passwords are omitted, random ones are generated once into data/INITIAL_CREDENTIALS.txt
STAFF_ADMIN_EMAIL=admin@neointegrations.com
STAFF_ADMIN_PASSWORD=
STAFF_MANAGER_EMAIL=manager@neointegrations.com
STAFF_MANAGER_PASSWORD=

# Contact form — email lands here
CONTACT_TO=Info@neointegrations.com
CONTACT_FROM=Neo Integrations <Info@neointegrations.com>

# Option A — Resend (preferred for production email)
RESEND_API_KEY=

# Option B — SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# If A and B are empty, the server emails Info@ via FormSubmit.
# First submission sends a confirmation link to that inbox — click it once.

# Phone alerts: ntfy is on by default (topic is stored in data/ntfy-topic.txt).
# Install the ntfy app and subscribe to the URL printed when the server starts.
# NTFY_TOPIC=
# NTFY_URL=https://ntfy.sh

# Optional Telegram (BotFather replies immediately — unlike CallMeBot):
# 1. Telegram → @BotFather → /newbot
# 2. Paste the token here, then send /start to your bot, then restart the server.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Official WhatsApp (Meta Cloud API or Twilio) — optional, needs a business number
WHATSAPP_TO=918789359477
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# WHATSAPP_WEBHOOK_URL=

# Public site origin for CSRF origin checks (set in production)
# PUBLIC_ORIGIN=https://your-domain.com
