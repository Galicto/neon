# Copy to .env and fill in. Never commit .env.

PORT=8080
NODE_ENV=development

# Required in production. 32+ random characters.
SESSION_SECRET=

# Staff accounts (bcrypt-equivalent scrypt hashes are created on first boot).
# If passwords are omitted, random ones are generated once into data/INITIAL_CREDENTIALS.txt
STAFF_ADMIN_EMAIL=admin@neointegrations.com
STAFF_ADMIN_PASSWORD=
STAFF_MANAGER_EMAIL=manager@neointegrations.com
STAFF_MANAGER_PASSWORD=

# Contact form — email lands here
CONTACT_TO=Info@neointegrations.com
CONTACT_FROM=Neo Integrations <Info@neointegrations.com>

# Option A — Resend (preferred for production email)
RESEND_API_KEY=

# Option B — SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# If A and B are empty, the server emails Info@ via FormSubmit.
# First submission sends a confirmation link to that inbox — click it once.

# WhatsApp alerts to +91 87893 59477 (all form fields)
WHATSAPP_TO=918789359477

# Easiest personal-WhatsApp path (CallMeBot):
# 1. On the phone 8789359477, add +34 644 51 95 23 as a contact
# 2. WhatsApp that contact: I allow callmebot to send me messages
# 3. Paste the apikey it replies with:
CALLMEBOT_APIKEY=

# Or official WhatsApp Cloud API
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# Or Twilio WhatsApp
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Or a Make/Zapier webhook that forwards JSON to WhatsApp
# WHATSAPP_WEBHOOK_URL=

# Public site origin for CSRF origin checks (set in production)
# PUBLIC_ORIGIN=https://your-domain.com
